{
  "$comment": "Single source of truth for the toolkit UI. Run `node scripts/build-tokens.mjs` after editing; it regenerates css/tokens.css and swift/SCTheme.swift. Colours are hex; the CSS build also emits space-separated RGB triplets so alpha variants can be written as rgb(var(--sc-accent-rgb) / 0.3).",

  "fonts": {
    "display": { "family": "Orbitron", "fallback": "\"Eurostile\", \"Bank Gothic\", \"Arial Narrow\", system-ui, sans-serif" },
    "ui": { "family": "Exo 2", "fallback": "\"Segoe UI\", system-ui, -apple-system, sans-serif" },
    "mono": { "family": "Share Tech Mono", "fallback": "ui-monospace, \"SF Mono\", Menlo, monospace" }
  },

  "size": {
    "text-xs": "11px",
    "text-sm": "12.5px",
    "text-md": "14px",
    "text-lg": "17px",
    "text-xl": "22px",
    "text-2xl": "30px",
    "text-3xl": "40px"
  },

  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px" },

  "shape": {
    "radius": "2px",
    "chamfer": "10px",
    "chamfer-sm": "6px",
    "bracket": "12px",
    "line": "1px"
  },

  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)"
  },

  "status": {
    "danger": "#ff4d5e",
    "warning": "#ffb020",
    "success": "#3ee07a",
    "info": "#4fc3ff"
  },

  "apps": {
    "$comment": "Identity colours, so each tool is recognisable inside the shared chrome. The first four match the source colours Metropolis already uses. Every colour sits at least 28 degrees of hue from every other app colour; keep that when adding one.",
    "heptabase": "#a48df0",
    "idef0": "#6aa8e6",
    "pyramid": "#e09a5a",
    "metropolis": "#3cbba7",
    "sysml": "#82cb4d",
    "project": "#55c364",
    "profiler": "#c173de",
    "hypermail": "#e873d1",
    "bom": "#ced24b",
    "habit": "#eb7aa0"
  },

  "races": {
    "steel": {
      "label": "Steel",
      "description": "Brushed steel with cyan readouts.",
      "colors": {
        "void": "#03060a",
        "bg": "#060b11",
        "panel": "#0c141c",
        "panel-2": "#111c27",
        "raised": "#16232f",
        "sunken": "#04080d",
        "line": "#1d3446",
        "line-strong": "#2f5b78",
        "text": "#d6e6f0",
        "text-2": "#8ea6b6",
        "text-3": "#56707f",
        "accent": "#3fb6ff",
        "accent-2": "#ffb347",
        "accent-ink": "#02121d",
        "glow": "#3fb6ff"
      }
    },
    "crystal": {
      "label": "Crystal",
      "description": "Deep blue crystal with warm gold.",
      "colors": {
        "void": "#02050c",
        "bg": "#050a18",
        "panel": "#0a1226",
        "panel-2": "#0f1a33",
        "raised": "#142140",
        "sunken": "#030713",
        "line": "#1c2f57",
        "line-strong": "#3a5a8f",
